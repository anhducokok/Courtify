generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
enum FieldFeature {
  LED
  VIP
  ROOFED
  AIR_CONDITIONED
}

// USER
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  role          Role      @default(USER)
  refreshToken  String?   @db.Text

  bookings      Booking[]
  courts        Court[]   @relation("OwnerCourts")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Court {
  id            String   @id @default(uuid())
  name          String
  location      String

  latitude      Float?
  longitude     Float?

  averageRating Float    @default(0)
  reviewCount   Int      @default(0)

  ownerId       String?
  owner         User?    @relation("OwnerCourts", fields: [ownerId], references: [id])

  fields        Field[]   // 👈 quan trọng

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// TIMESLOT (Reusable)
model TimeSlot {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime

  bookings  Booking[]

  createdAt DateTime @default(now())

  @@unique([startTime, endTime])
}

// BOOKING
model Booking {
  id         String        @id @default(uuid())

  userId     String
  fieldId    String   
  timeSlotId String

  date       DateTime
  status     BookingStatus @default(PENDING)

  user       User     @relation(fields: [userId], references: [id])
  field      Field    @relation(fields: [fieldId], references: [id])
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([fieldId, timeSlotId, date])
  @@index([fieldId, date])
  @@index([userId])
}
model Field {
  id            String   @id @default(uuid())
  name          String

  pricePerHour  Decimal  @db.Decimal(10,2)
  features      FieldFeature[]

  courtId       String
  court         Court    @relation(fields: [courtId], references: [id])

  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courtId])
}